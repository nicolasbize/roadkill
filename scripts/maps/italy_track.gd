class_name ItalyTrack
extends TrackDefinition

# Italy twists and turns, mimics dry country side

func lay_out(track: Track) -> void:
	# quick turns from the start
	track.add_straight(110)
	track.add_curve(30, 70, 30, -120.0)
	track.add_hill(20, 14, 20, 10.0)
	track.add_straight(60, "turn_right", Track.LEFT)
	track.add_curve(25, 60, 25, 88.0)
	track.add_curved_hill(25, 50, 25, -76.0, -12.0)
	track.add_straight(70)
	track.add_curve(20, 20, 20, 72.0)
	track.add_curve(20, 20, 20, -72.0)
	track.add_curve(20, 20, 20, 72.0)
	track.add_hill(20, 12, 20, 14.0)
	track.add_straight(80, "turn_left", Track.RIGHT)
	track.add_curve(25, 75, 25, -64.0)
	track.add_curved_hill(25, 45, 25, 95.0, -16.0)
	track.add_straight(100)

	# climb with lots of turns
	track.add_straight(50, "turn_left", Track.RIGHT)
	track.add_curved_hill(25, 55, 25, -48.0, 14.0)
	track.add_straight(45, "turn_right", Track.LEFT)
	track.add_curve(20, 24, 20, 44.0)
	track.add_hill(15, 10, 15, 12.0)
	track.add_curve(20, 26, 20, -42.0)
	track.add_straight(60, "turn_right", Track.LEFT)
	track.add_curve(20, 22, 20, 50.0)
	track.add_curve(20, 22, 20, -50.0)
	track.add_curved_hill(20, 40, 20, 58.0, -18.0)
	track.add_straight(70, "turn_left", Track.RIGHT)
	track.add_curve(25, 60, 25, -54.0)
	track.add_straight(90)

	# longer straights but tight corners still
	track.add_curved_hill(30, 60, 30, 140.0, 18.0)
	track.add_hill(20, 12, 20, -16.0)
	track.add_curve(25, 55, 25, -85.0)
	track.add_hill(20, 12, 20, 16.0)
	track.add_curve(25, 55, 25, 85.0)
	track.add_hill(20, 12, 20, -14.0)
	track.add_straight(70, "turn_left", Track.RIGHT)
	track.add_curved_hill(25, 65, 25, -70.0, 20.0)
	track.add_straight(90)
	track.add_curve(20, 18, 20, 80.0)
	track.add_curve(20, 18, 20, -80.0)
	track.add_curved_hill(25, 50, 25, 66.0, -18.0)
	track.add_straight(110, "turn_right", Track.LEFT)
	track.add_curve(30, 70, 30, 100.0)
	track.add_hill(20, 14, 20, 12.0)
	track.add_straight(120)

	# hills and turns again
	track.add_straight(60, "turn_right", Track.LEFT)
	track.add_curved_hill(25, 70, 25, 46.0, 22.0)
	track.add_straight(55, "turn_left", Track.RIGHT)
	track.add_curved_hill(25, 75, 25, -42.0, 22.0)
	track.add_straight(50, "turn_right", Track.LEFT)
	track.add_curved_hill(25, 70, 25, 44.0, 20.0)
	track.add_curve(20, 30, 20, -90.0)
	track.add_hill(15, 10, 15, 10.0)
	track.add_straight(50, "turn_left", Track.RIGHT)
	track.add_curved_hill(25, 80, 25, -40.0, 24.0)
	track.add_straight(55, "turn_right", Track.LEFT)
	track.add_curved_hill(25, 70, 25, 48.0, 20.0)
	track.add_straight(45, "turn_left", Track.RIGHT)
	track.add_curved_hill(25, 75, 25, -44.0, 18.0)
	track.add_straight(80)
	track.add_curve(30, 60, 30, 110.0)
	track.add_hill(25, 18, 25, 12.0)

	# fast downhill with tricky corners at the end
	track.add_curved_hill(35, 85, 35, -170.0, -30.0)
	track.add_straight(130)
	track.add_curve(20, 16, 20, 92.0)
	track.add_curve(20, 16, 20, -92.0)
	track.add_curved_hill(30, 70, 30, 120.0, -28.0)
	track.add_straight(100, "turn_left", Track.RIGHT)
	track.add_curve(25, 65, 25, -62.0)
	track.add_curved_hill(25, 50, 25, 78.0, -24.0)
	track.add_straight(120)
	track.add_curve(20, 18, 20, -76.0)
	track.add_curve(20, 18, 20, 76.0)
	track.add_curved_hill(30, 75, 30, -150.0, -32.0)
	track.add_straight(140)
	track.add_hill(20, 14, 20, -18.0)
	track.add_curve(25, 60, 25, 68.0)
	track.add_straight(110, "turn_left", Track.RIGHT)
	track.add_curved_hill(30, 80, 30, -95.0, -28.0)
	track.add_straight(130)

	# final straight / slow turn
	track.add_curve(25, 70, 25, 56.0)
	track.add_straight(90, "turn_left", Track.RIGHT)
	track.add_curve(20, 20, 20, -66.0)
	track.add_curve(20, 20, 20, 66.0)
	track.add_hill(20, 12, 20, 12.0)
	track.add_straight(100, "turn_right", Track.LEFT)
	track.add_curve(30, 85, 30, 52.0)
	track.add_straight(120)
	track.add_hill(30, 20, 30, -22.0)
	track.add_curve(35, 70, 35, 175.0)
	track.add_straight(260)
	track.add_curve(40, 60, 40, 210.0)
	track.add_straight(150)
